# ============================================================================
# Campus Court — environment configuration
# Copy this file to `.env` (same folder as server.js) and fill in what you need.
# EVERY variable is optional: with an empty .env the app still runs fully
# offline (local fallback judge + console dry-run email + demo mode).
# Secrets live ONLY here on the server — never in public/ or the frontend.
# ============================================================================

# --- Server -----------------------------------------------------------------
PORT=3000                       # HTTP port (default 3000)
BASE_URL=http://localhost:3000  # Public origin used inside invitation links.
                                # Set to your deployed URL in production so
                                # emailed links point at the right host.

# --- Demo mode --------------------------------------------------------------
DEMO=1                          # 1 (default) = single-laptop demo: shows the
                                # "act as other side" switch in courtrooms and
                                # returns dry-run invite links in API responses.
                                # 0 = production: hides act-as, no link leakage.
DEMO_EMAIL=                     # Optional. If set, ALL outgoing mail (invites +
                                # admin notices) is redirected to this one inbox
                                # so a single laptop can demo every role.
                                # Leave empty to mail each real recipient.

# --- Case / invitation timings ---------------------------------------------
CASE_HOURS=5                    # Hours an accused has to appear before default.
INVITE_HOURS=48                 # Lifetime of a secure invitation token (hours).

# --- Database ---------------------------------------------------------------
DB_FILE=                        # Optional path to the JSON database file.
                                # Default: ./data/db.json (auto-created + seeded
                                # + migrated on first run). Tests set their own.

# --- Email (Gmail, free tier) ------------------------------------------------
# Google Account > Security > 2-Step Verification > App passwords.
# Without these the mailer stays in console dry-run (links still work in DEMO).
GMAIL_USER=                     # e.g. haroonsheik0127@gmail.com
GMAIL_APP_PASSWORD=             # 16-char app password (NOT your login password)

# --- AI judge (free tiers, optional) -----------------------------------------
# Comma-separated lists; the server rotates keys and cools down a key for 60s
# when it errors / rate-limits, then falls back Gemini -> Groq -> local judge.
GEMINI_KEYS=                    # https://aistudio.google.com/apikey
GROQ_KEYS=                      # https://console.groq.com/keys
GEMINI_MODEL=gemini-2.0-flash   # optional model override
GROQ_MODEL=llama-3.3-70b-versatile  # optional model override
# Admin password for the seeded admin account (choose your own; do not commit the real one)
ADMIN_PASSWORD=